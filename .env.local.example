# Web3Forms access key — https://web3forms.com (free, no account required)
# Copy this file to .env.local and paste the key you receive by email.
# On Vercel, enable this for Preview and Development too, not Production only:
# it is inlined at build time, and a branch deploy builds as Preview.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Canonical site URL, no trailing slash. Used for metadataBase, canonical/hreflang
# URLs, the sitemap, and robots.txt — falls back to https://nomeny.dev if unset.
NEXT_PUBLIC_SITE_URL=

# Google Gemini API key for the "Ydiboras AI" chatbot — https://aistudio.google.com
# Must be NEXT_PUBLIC_* so it is inlined into the static export (the site has no
# server). A browser-exposed key is public: use a restricted key, and for
# production proxy the call through a serverless function instead of shipping it.
NEXT_PUBLIC_GEMINI_KEY=