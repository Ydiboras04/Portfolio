{
  "version": "0.2",
  "language": "en,en-GB,fr",
  "import": [
    "@cspell/dict-fr-fr/cspell-ext.json"
  ],
  "ignorePaths": [
    "node_modules/**",
    ".next/**",
    "out/**",
    ".superpowers/**",
    "package-lock.json",
    "public/**",
    "*.pdf",
    "*.docx",
    "lighthouse-*.json"
  ],
  "ignoreRegExpList": [
    "TailwindArbitraryValue",
    "LongHexOrHash",
    "CssHexColor"
  ],
  "patterns": [
    {
      "name": "TailwindArbitraryValue",
      "pattern": "/\\[[^\\]\\s]*\\]/g"
    },
    {
      "name": "LongHexOrHash",
      "pattern": "/\\b[0-9a-f]{16,}\\b/gi"
    },
    {
      "name": "CssHexColor",
      "pattern": "/#[0-9a-fA-F]{3,8}\\b/g"
    }
  ],
  "words": [
    "andria",
    "andriamaheva",
    "antananarivo",
    "antsimondrano",
    "bezier",
    "botcheck",
    "cidst",
    "cookieless",
    "crawlable",
    "crossfade",
    "cspell",
    "esmia",
    "esnext",
    "fullbleed",
    "grotesk",
    "hreflang",
    "hrefs",
    "itaosy",
    "ivandry",
    "jetbrains",
    "jlpt",
    "jsdom",
    "mahamasina",
    "malagasy",
    "miage",
    "mitia",
    "nomeny",
    "nomenymitia",
    "noscript",
    "opengraph",
    "overclaiming",
    "pdftotext",
    "pgi",
    "plex",
    "pointermove",
    "rgba",
    "rohy",
    "soluchat",
    "solumada",
    "tahina",
    "tailwindcss",
    "tsimbazaza",
    "turbopack",
    "unevidenced",
    "unobserve",
    "unscanned",
    "unscrolled",
    "wayfinding",
    "wcag",
    "wordmark",
    "zarahay"
  ]
}
